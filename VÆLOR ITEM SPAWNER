-- Inventory changes update visible state; one small poll also catches GunName changes.
M.spawn(function()
    local previous = ""
    while not M.dead do
        local owned = M.inventory()
        local names = {}
        for name in pairs(owned) do names[#names + 1] = name end
        table.sort(names)
        local signature = table.concat(names, "\n")
        if signature ~= previous then
            previous = signature
            for _, tool in pairs(owned) do M.observe(tool, "Your inventory") end
            M.merge()
        end
        task.wait(0.7)
    end
end)

-- Catch tools that stream/spawn after the initial deep scan without rescanning the whole place.
local function watchRoot(root)
    if not root then return end
    M.track(root.DescendantAdded:Connect(function(object)
        if M.dead then return end
        if object:IsA("Tool") then
            M.observe(object, "Spawned/streamed live")
            M.merge()
        elseif object:IsA("StringValue") then
            local lower = object.Name:gsub("[^%w]", ""):lower()
            if lower == "toolname" or lower == "toolid" then
                M.inspectDiscoveryObject(object)
                M.merge()
            end
        end
    end))
end
watchRoot(workspace)
watchRoot(M.RS)
watchRoot(M.PlayerGui)

